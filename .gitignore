/*.xml
/*.prx
/*.zip
/buy-*.toml
buy-plan*.json
inventory*.json

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/

# --- OS / editor ---
.DS_Store
Thumbs.db
*.swp

# --- Claude Code session dirs (worktrees live under .claude/) ---
.claude/
