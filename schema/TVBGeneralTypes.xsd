  <xs:element name="Tuesday"   type="tp:YN"/>
  <xs:element name="Wednesday" type="tp:YN"/>
  <xs:element name="Thursday"  type="tp:YN"/>
  <xs:element name="Friday"    type="tp:YN"/>
  <xs:element name="Saturday"  type="tp:YN"/>
  <xs:element name="Sunday"    type="tp:YN"/>
</xs:schema>
