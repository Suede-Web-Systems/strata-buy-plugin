<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="http://www.AAAA.org/schemas/TVBGeneralTypes"
           xmlns:tp="http://www.AAAA.org/schemas/TVBGeneralTypes"
           elementFormDefault="qualified">

  <xs:simpleType name="YN">
    <xs:restriction base="xs:string">
      <xs:enumeration value="Y"/>
      <xs:enumeration value="N"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:element name="CommentLine" type="xs:string"/>

  <!-- Day-of-week Y/N flags used inside <Days> (note: SpotsByDay weekday elements
       are in the *proposal* namespace, not this one) -->
